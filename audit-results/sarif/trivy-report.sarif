            {
              "id": "CVE-2024-6104",
              "name": "go-retryablehttp URL Credentials Vulnerability",
              "shortDescription": {
                "text": "Sensitive information disclosure via URL credentials logging"
              },
              "fullDescription": {
                "text": "go-retryablehttp prior to version 0.7.7 would log the Authorization header when using a custom Logger. This could lead to sensitive information disclosure when credentials are included in the Authorization header."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2024-6104",
              "help": {
                "text": "Vulnerability CVE-2024-6104\nSeverity: MEDIUM\nPackage: github.com/hashicorp/go-retryablehttp\nFixed Version: 0.7.7\nLink: https://nvd.nist.gov/vuln/detail/CVE-2024-6104",
                "markdown": "**Vulnerability CVE-2024-6104**\n| Severity | Package | Fixed Version |\n| --- | --- | --- |\n| MEDIUM | github.com/hashicorp/go-retryablehttp | 0.7.7 |\n\n[More Info](https://nvd.nist.gov/vuln/detail/CVE-2024-6104)"
              },
              "properties": {
                "precision": "high",
