            {
              "id": "CVE-2023-45288",
              "name": "HTTP/2 CONTINUATION Flood Vulnerability",
              "shortDescription": {
                "text": "HTTP/2 CONTINUATION frame flood causing resource exhaustion"
              },
              "fullDescription": {
                "text": "An attacker may cause an HTTP/2 endpoint to read arbitrary amounts of header data by sending an excessive number of CONTINUATION frames. Maintaining HPACK state requires parsing and processing all HEADERS and CONTINUATION frames on a connection, which can cause excessive CPU usage when many CONTINUATION frames are sent."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2023-45288",
              "help": {
                "text": "Vulnerability CVE-2023-45288\nSeverity: HIGH\nPackage: golang.org/x/net\nFixed Version: 0.23.0\nLink: https://nvd.nist.gov/vuln/detail/CVE-2023-45288",
                "markdown": "**Vulnerability CVE-2023-45288**\n| Severity | Package | Fixed Version |\n| --- | --- | --- |\n| HIGH | golang.org/x/net | 0.23.0 |\n\n[More Info](https://nvd.nist.gov/vuln/detail/CVE-2023-45288)"
              },
              "properties": {
                "precision": "very-high",
                "security-severity": "7.5",
                "tags": [
                  "vulnerability",
                  "security",
                  "HIGH",
                  "CWE-400",
                  "go",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "CVE-2024-24786",
              "name": "google.golang.org/protobuf Vulnerability",
              "shortDescription": {
                "text": "Infinite loop in protobuf unmarshal"
              },
              "fullDescription": {
                "text": "The protojson.Unmarshal function can enter an infinite loop when unmarshaling certain forms of invalid JSON. This condition can only occur when unmarshaling into a message which contains a google.protobuf.Any value, or when the UnmarshalOptions.DiscardUnknown option is set."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2024-24786",
              "help": {
                "text": "Vulnerability CVE-2024-24786\nSeverity: MEDIUM\nPackage: google.golang.org/protobuf\nFixed Version: 1.33.0\nLink: https://nvd.nist.gov/vuln/detail/CVE-2024-24786",
                "markdown": "**Vulnerability CVE-2024-24786**\n| Severity | Package | Fixed Version |\n| --- | --- | --- |\n| MEDIUM | google.golang.org/protobuf | 1.33.0 |\n\n[More Info](https://nvd.nist.gov/vuln/detail/CVE-2024-24786)"
              },
              "properties": {
                "precision": "high",
                "security-severity": "5.9",
                "tags": [
