                  "stdlib"
                ]
              }
            },
            {
              "id": "CVE-2024-34156",
              "name": "encoding/gob Decoding Vulnerability",
              "shortDescription": {
                "text": "Stack exhaustion in encoding/gob Decoder"
              },
              "fullDescription": {
                "text": "Calling Decoder.Decode on a message which contains deeply nested structures can cause a panic due to stack exhaustion. This is a follow up issue to CVE-2022-30635 which was not fully addressed."
              },
              "helpUri": "https://nvd.nist.gov/vuln/detail/CVE-2024-34156",
              "help": {
                "text": "Vulnerability CVE-2024-34156\nSeverity: HIGH\nPackage: stdlib\nFixed Version: 1.22.7, 1.23.1\nLink: https://nvd.nist.gov/vuln/detail/CVE-2024-34156",
                "markdown": "**Vulnerability CVE-2024-34156**\n| Severity | Package | Fixed Version |\n| --- | --- | --- |\n| HIGH | stdlib | 1.22.7, 1.23.1 |\n\n[More Info](https://nvd.nist.gov/vuln/detail/CVE-2024-34156)"
              },
              "properties": {
