          "level": "warning",
          "message": {
            "text": "Misconfiguration: Privileged Container\n\nThe DaemonSet 'calico-node' in namespace 'kube-system' runs containers in privileged mode.\n\nPrivileged containers have all of the root capabilities of the host machine, allowing potential container escape and unauthorized access to host resources.\n\nRemediation: Set securityContext.privileged to false unless strictly required for the workload."
          },
          "locations": [
            {
              "physicalLocation": {
