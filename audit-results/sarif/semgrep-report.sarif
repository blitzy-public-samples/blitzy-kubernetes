              "name": "RunAsRoot",
              "shortDescription": {
                "text": "Container running as root user"
              },
              "fullDescription": {
                "text": "Detected container configured to run as root (runAsUser: 0 or runAsNonRoot: false). Running as root increases the impact of container escape vulnerabilities. Configure containers to run as non-root users."
              },
              "helpUri": "https://semgrep.dev/r/yaml.kubernetes.security.run-as-root",
              "defaultConfiguration": {
                "level": "warning"
