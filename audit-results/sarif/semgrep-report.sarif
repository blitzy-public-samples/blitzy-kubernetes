          "ruleId": "go.lang.security.audit.dangerous-exec-command",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "Detected exec.Command with variable arguments. The command 'nsenter' is executed with arguments that include user-controllable paths. This could allow command injection if the container ID or paths are not properly validated. Ensure all inputs are sanitized before passing to exec.Command."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "pkg/kubelet/kuberuntime/kuberuntime_container.go",
                  "uriBaseId": "%SRCROOT%"
