{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Semgrep",
          "version": "1.150.0",
          "semanticVersion": "1.150.0",
          "informationUri": "https://semgrep.dev/",
          "rules": [
            {
              "id": "go.lang.security.audit.xss.no-direct-write-to-responsewriter",
              "name": "NoDirectWriteToResponseWriter",
              "shortDescription": {
                "text": "Direct write to http.ResponseWriter without content-type validation"
              },
              "fullDescription": {
                "text": "Detected a direct write to http.ResponseWriter. This can lead to cross-site scripting (XSS) vulnerabilities if user-controlled data is written without proper encoding. Ensure proper content-type headers are set and output is encoded appropriately."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.xss.no-direct-write-to-responsewriter",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "security-severity": "6.1",
                "tags": [
                  "security",
                  "CWE-79",
                  "OWASP-A03:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.dangerous-exec-command",
              "name": "DangerousExecCommand",
              "shortDescription": {
                "text": "Potential command injection via exec.Command with variable arguments"
              },
              "fullDescription": {
                "text": "Detected use of exec.Command with variable arguments that may contain user-controlled data. This could allow command injection attacks. Validate and sanitize all inputs before passing to system commands."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.dangerous-exec-command",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "9.8",
                "tags": [
                  "security",
                  "CWE-78",
                  "OWASP-A03:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.crypto.use-of-weak-crypto",
              "name": "UseOfWeakCrypto",
              "shortDescription": {
                "text": "Use of weak cryptographic algorithm detected"
              },
              "fullDescription": {
                "text": "Weak cryptographic algorithm detected. MD5 and SHA1 are considered cryptographically weak for security-sensitive operations. Use SHA-256 or stronger algorithms for cryptographic purposes."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.crypto.use-of-weak-crypto",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "5.3",
                "tags": [
                  "security",
                  "CWE-327",
                  "CWE-328",
                  "OWASP-A02:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.net.unvalidated-redirect",
              "name": "UnvalidatedRedirect",
              "shortDescription": {
                "text": "Unvalidated URL redirect detected"
              },
              "fullDescription": {
                "text": "Detected a redirect using user-controlled input without validation. This can lead to open redirect vulnerabilities allowing attackers to redirect users to malicious sites. Validate redirect URLs against an allowlist."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.net.unvalidated-redirect",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "security-severity": "6.1",
                "tags": [
                  "security",
                  "CWE-601",
                  "OWASP-A01:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.dangerous-syscall",
              "name": "DangerousSyscall",
              "shortDescription": {
                "text": "Dangerous system call with potential privilege escalation"
              },
              "fullDescription": {
                "text": "Detected use of potentially dangerous system calls that could lead to privilege escalation or security bypass. Review the necessity of this syscall and ensure proper access controls are in place."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.dangerous-syscall",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "CWE-250",
                  "CWE-269",
                  "OWASP-A04:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.path-traversal",
              "name": "PathTraversal",
              "shortDescription": {
                "text": "Potential path traversal vulnerability"
              },
              "fullDescription": {
                "text": "Detected file path construction using user-controlled input without proper validation. This could allow attackers to access files outside the intended directory. Use filepath.Clean and validate paths against a base directory."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.path-traversal",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "CWE-22",
                  "OWASP-A01:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.tls.insecure-tls-version",
              "name": "InsecureTLSVersion",
              "shortDescription": {
                "text": "Insecure TLS version configuration detected"
              },
              "fullDescription": {
                "text": "TLS configuration allows insecure protocol versions (TLS 1.0 or 1.1). These versions have known vulnerabilities. Configure MinVersion to tls.VersionTLS12 or higher."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.tls.insecure-tls-version",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "5.9",
                "tags": [
                  "security",
                  "CWE-326",
                  "OWASP-A02:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.tls.skip-verify",
              "name": "TLSInsecureSkipVerify",
              "shortDescription": {
                "text": "TLS certificate verification disabled"
              },
              "fullDescription": {
                "text": "TLS InsecureSkipVerify is set to true, disabling certificate verification. This makes the connection vulnerable to man-in-the-middle attacks. Remove this setting in production code."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.tls.skip-verify",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "8.1",
                "tags": [
                  "security",
                  "CWE-295",
                  "OWASP-A07:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.ssrf.http-request-with-variable-url",
              "name": "SSRFHTTPRequestVariableURL",
              "shortDescription": {
                "text": "Server-side request forgery (SSRF) via variable URL"
              },
              "fullDescription": {
                "text": "Detected an HTTP request with a URL constructed from variable input. This could allow server-side request forgery (SSRF) attacks. Validate URLs against an allowlist of permitted hosts."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.ssrf.http-request-with-variable-url",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "CWE-918",
                  "OWASP-A10:2021"
                ]
              }
            },
            {
              "id": "go.lang.security.audit.secrets.hardcoded-secret",
              "name": "HardcodedSecret",
              "shortDescription": {
                "text": "Hardcoded secret or credential detected"
              },
              "fullDescription": {
                "text": "Detected a hardcoded secret, password, or API key in source code. Secrets should be stored in secure secret management systems and accessed via environment variables or secret managers."
              },
              "helpUri": "https://semgrep.dev/r/go.lang.security.audit.secrets.hardcoded-secret",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "8.9",
                "tags": [
                  "security",
                  "CWE-798",
                  "OWASP-A07:2021"
                ]
              }
            },
            {
              "id": "bash.lang.security.audit.unquoted-variable-expansion",
              "name": "UnquotedVariableExpansion",
              "shortDescription": {
                "text": "Unquoted variable expansion in shell script"
              },
              "fullDescription": {
                "text": "Detected unquoted variable expansion which can lead to word splitting and globbing issues. This can cause unexpected behavior or security vulnerabilities. Always quote variable expansions: \"$var\" instead of $var."
              },
              "helpUri": "https://semgrep.dev/r/bash.lang.security.audit.unquoted-variable-expansion",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "security-severity": "4.3",
                "tags": [
                  "security",
                  "CWE-78",
                  "shell"
                ]
              }
            },
            {
              "id": "bash.lang.security.audit.dangerous-command-injection",
              "name": "DangerousCommandInjection",
              "shortDescription": {
                "text": "Potential command injection in shell script"
              },
              "fullDescription": {
                "text": "Detected a command that uses variable expansion in a way that could allow command injection. Use proper quoting and input validation to prevent injection attacks."
              },
              "helpUri": "https://semgrep.dev/r/bash.lang.security.audit.dangerous-command-injection",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "9.1",
                "tags": [
                  "security",
                  "CWE-78",
                  "CWE-77",
                  "OWASP-A03:2021",
                  "shell"
                ]
              }
            },
            {
              "id": "bash.lang.security.audit.curl-insecure",
              "name": "CurlInsecure",
              "shortDescription": {
                "text": "Insecure curl command with -k or --insecure flag"
              },
              "fullDescription": {
                "text": "Detected curl command with -k or --insecure flag which disables SSL certificate verification. This makes the connection vulnerable to man-in-the-middle attacks. Remove this flag in production scripts."
              },
              "helpUri": "https://semgrep.dev/r/bash.lang.security.audit.curl-insecure",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "5.9",
                "tags": [
                  "security",
                  "CWE-295",
                  "shell"
                ]
              }
            },
            {
              "id": "bash.lang.security.audit.eval-usage",
              "name": "EvalUsage",
              "shortDescription": {
                "text": "Dangerous use of eval in shell script"
              },
              "fullDescription": {
                "text": "Detected use of eval which can execute arbitrary commands. If the input to eval contains user-controlled data, this could lead to command injection. Avoid eval or ensure input is strictly validated."
              },
              "helpUri": "https://semgrep.dev/r/bash.lang.security.audit.eval-usage",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "medium",
                "security-severity": "7.5",
                "tags": [
                  "security",
                  "CWE-78",
                  "CWE-95",
                  "shell"
                ]
              }
            },
            {
              "id": "bash.lang.security.audit.chmod-777",
              "name": "Chmod777",
              "shortDescription": {
                "text": "Insecure file permissions: chmod 777"
              },
              "fullDescription": {
                "text": "Detected chmod with overly permissive mode 777. This grants read, write, and execute permissions to all users, which is a security risk. Use more restrictive permissions."
              },
              "helpUri": "https://semgrep.dev/r/bash.lang.security.audit.chmod-777",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "5.3",
                "tags": [
                  "security",
                  "CWE-732",
                  "shell"
                ]
              }
            },
            {
              "id": "yaml.kubernetes.security.privileged-container",
              "name": "PrivilegedContainer",
              "shortDescription": {
                "text": "Privileged container detected in Kubernetes manifest"
              },
              "fullDescription": {
                "text": "Detected a container running with privileged: true. Privileged containers have full access to the host system and should be avoided unless absolutely necessary. Consider using specific capabilities instead."
              },
              "helpUri": "https://semgrep.dev/r/yaml.kubernetes.security.privileged-container",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "precision": "high",
                "security-severity": "8.8",
                "tags": [
                  "security",
                  "CWE-250",
                  "kubernetes",
                  "OWASP-A05:2021"
                ]
              }
            },
            {
              "id": "yaml.kubernetes.security.hostnetwork-enabled",
              "name": "HostNetworkEnabled",
              "shortDescription": {
                "text": "Host network enabled in Kubernetes pod"
              },
              "fullDescription": {
                "text": "Detected hostNetwork: true which allows the pod to use the host's network namespace. This breaks network isolation and can be a security risk. Only enable if specifically required."
              },
              "helpUri": "https://semgrep.dev/r/yaml.kubernetes.security.hostnetwork-enabled",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "6.5",
                "tags": [
                  "security",
                  "CWE-668",
                  "kubernetes"
                ]
              }
            },
            {
              "id": "yaml.kubernetes.security.hostpath-mount",
              "name": "HostPathMount",
              "shortDescription": {
                "text": "HostPath volume mount detected"
              },
              "fullDescription": {
                "text": "Detected a hostPath volume mount which provides direct access to the host filesystem. This can be exploited to escape container isolation. Use persistent volumes or other storage abstractions instead."
              },
              "helpUri": "https://semgrep.dev/r/yaml.kubernetes.security.hostpath-mount",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "precision": "high",
                "security-severity": "6.5",
