                "region": {
                  "startLine": 847,
                  "endLine": 852,
                  "snippet": {
                    "text": "func (m *kubeGenericRuntimeManager) executePreStopHook(ctx context.Context, pod *v1.Pod, container *v1.Container, containerID kubecontainer.ContainerID, gracePeriod int64) error {\n\t// Execute pre-stop hook\n\tcmd := exec.Command(\"nsenter\", \"-t\", strconv.Itoa(pid), \"-m\", \"-u\", \"-i\", \"-n\", \"-p\", \"--\", container.Lifecycle.PreStop.Exec.Command...)\n\treturn cmd.Run()"
                  }
                }
              }
            }
          ],
